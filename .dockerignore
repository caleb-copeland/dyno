# Dependencies — installed inside the image build
node_modules
vendor

# VCS / editor / AI cruft
.git
.gitattributes
.gitignore
.github
.editorconfig
.claude
.codex
.cursor
.idea
.nova
.vscode
.zed
.phpactor.json

# Secrets & local env — never bake into the image
.env
.env.*
auth.json
storage/*.key

# Runtime state (recreated by the Dockerfile / entrypoint)
storage/app/public/*
storage/app/private/*
storage/framework/*
storage/logs/*
storage/pail

# Local database
database/database.sqlite

# Build artifacts — produced fresh in the image
public/build
public/hot
public/storage

# Tests / dev tooling
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# Docker / docs — not needed inside the image
Dockerfile
.dockerignore
compose.yaml
compose.prod.yaml
Makefile
README.md
CLAUDE.md
DEPLOY.md

# Misc
*.log
.DS_Store
Thumbs.db
