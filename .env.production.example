# Production env for Dyno — copy to .env and fill the blanks. See DEPLOY.md.
APP_NAME=Dyno
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dyno.gizmostash.com

# Host Traefik routes to this app (matches the compose labels).
APP_HOST=dyno.gizmostash.com

APP_TIMEZONE=America/Detroit

# Logs to stderr so `docker compose logs` shows them.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (internal network; strong, distinct passwords) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dyno
DB_USERNAME=dyno
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions / cache / queue (all in the database; no Redis needed) ---
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (password-reset links). `log` just writes them to the log; `smtp` sends. ---
# For smtp: host/port/credentials from your provider. Port 587 = STARTTLS (leave
# MAIL_SCHEME blank); port 465 = implicit TLS (MAIL_SCHEME=smtps). The from-address
# domain needs the provider's SPF/DKIM records in DNS or mail lands in spam.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@dyno.gizmostash.com
MAIL_FROM_NAME=Dyno

# --- Web Push (optional). Generate with: artisan app:vapid ---
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
